<%- include('partials/header') %>
<h1>Latest Posts</h1>
<% if (posts.length === 0) { %>
  <p>No posts published yet.</p>
<% } %>
<% posts.forEach(post => { %>
  <div class="card">
    <h2><a href="/post/<%= post.id %>" style="color: inherit; text-decoration: none;"><%= post.title %></a></h2>
    <p style="color: #64748b; font-size: 0.875rem;">By <%= post.author %> on <%= post.date %></p>
    <p><%= post.content.substring(0, 150) %>...</p>
    <a href="/post/<%= post.id %>" class="btn">Read More</a>
  </div>
<% }) %>
<%- include('partials/footer') %>
