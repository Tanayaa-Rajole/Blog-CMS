<%- include('partials/header') %>
<h1>Admin Dashboard</h1>

<div class="card">
  <h2>Create New Post</h2>
  <form action="/admin/create" method="POST">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required>

    <label for="author">Author</label>
    <input type="text" id="author" name="author" required>

    <label for="content">Content</label>
    <textarea id="content" name="content" rows="6" required></textarea>

    <br><br>
    <button type="submit" class="btn">Publish Post</button>
  </form>
</div>

<h2>Manage Posts</h2>
<div class="card">
  <% posts.forEach(post => { %>
    <div class="admin-list-item">
      <div>
        <strong><%= post.title %></strong>
        <span style="color: #64748b; font-size: 0.85rem;">(<%= post.date %>)</span>
      </div>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/admin/edit/<%= post.id %>" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Edit</a>
        <form action="/admin/delete/<%= post.id %>" method="POST" onsubmit="return confirm('Delete this post?');">
          <button type="submit" class="btn btn-danger" style="padding: 0.25rem 0.5rem; font-size: 0.875rem;">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
